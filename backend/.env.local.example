# Local development only. Never commit real values.
# Copy to .env.local (gitignored) and fill in.

AWS_REGION=us-east-1
SECRETS_MANAGER_SECRET_ID=relaywise/lambda/secrets

COMPOSIO_API_KEY=

# Where Composio sends the user's browser after OAuth consent. Must be a
# frontend page, not an API endpoint.
CALLBACK_URL=http://localhost:3000/integrations

BEDROCK_MANTLE_BASE_URL=https://bedrock-mantle.us-east-1.api.aws/v1
BEDROCK_MANTLE_API_KEY=
BEDROCK_MODEL_ID=

DATABASE_URL=
APPSYNC_EVENTS_ENDPOINT=
APPSYNC_API_KEY=
SQS_QUEUE_URL=

UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Evals and tracing (optional) --------------------------------------------
# Needed only to run evals locally or trace a local agent run. Production
# tracing reads the same key from Secrets Manager instead — this file is for
# your machine, and the key must never be committed.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=relaywise-dev
