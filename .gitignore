scratch/
/tests/

# Private project-planning material
.kiro/

# Local credentials and environment files
.env
.env.*
!.env.example
!.env.local.example

# Python environments and generated files
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/
.mypy_cache/

# JavaScript dependencies and build output
node_modules/
.next/
dist/
build/
coverage/

# Terraform local state and generated working data
**/.terraform/
**/*.tfstate
**/*.tfstate.*
**/*.tfplan

# Local editor and OS files
#
# These describe one machine's setup, not the project. Note that adding a path
# here does not untrack a file already in the index — .gitignore is only
# consulted for files git is not yet tracking.
.vscode/
.claude/
.idea/
.DS_Store
Thumbs.db

# Terraform variable files hold per-person values (contact addresses, ids).
# Only the .example is committed.
*.tfvars
!*.tfvars.example
